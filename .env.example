# Neon Serverless PostgreSQL Database URL
# Create a free Neon database at https://neon.tech and paste your pooled connection string below:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Doctor Admin Passcode (Set a secure private passcode in your environment variables)
ADMIN_PASSWORD="your-secure-admin-passcode-here"
